[Unit]
Description=Structural Calc FastAPI backend
After=network.target

[Service]
User=structcalc
WorkingDirectory=/opt/structuralcalc/app/backend
EnvironmentFile=/opt/structuralcalc/app/backend/.env
ExecStart=/opt/structuralcalc/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
