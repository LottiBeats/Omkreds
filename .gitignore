# Frontend
node_modules/
frontend/.env.local
# Built output. deploy.sh runs `npm run build` on the server, which rewrote
# these files and left the working tree dirty — so the next `git pull` aborted
# and the deploy stopped halfway. The server builds its own; nothing needs the
# committed copy.
frontend/dist/

# Database
*.db
*.db-shm
*.db-wal
*.sqlite

# OS
.DS_Store
Thumbs.db

# Deploy-nøgler hører aldrig i repoet — den private del ligger i ~/.ssh
# og i GitHub Secrets, ikke her.
# Kun de private halvdele. Wildcards her tog også .pub-filerne, og
# deploy/omkreds_deploy.pub SKAL med — den er offentlig, og serveren henter
# den derfra. git add sprang den bare over uden at sige noget.
*.pem
id_ed25519
omkreds_deploy
