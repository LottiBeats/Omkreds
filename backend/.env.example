# Copy to .env or set as systemd / Docker environment variables.

# Clerk: your Frontend API URL (from dashboard.clerk.com -> API Keys -> "Clerk API URL")
# Examples:
#   Development: https://fond-panda-42.clerk.accounts.dev
#   Production:  https://clerk.yourdomain.com
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev

# SQLite database path
DATABASE_PATH=/opt/structuralcalc/data/projects.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com
