{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Modelvinduet: gem/åbn-dialoger og læs/skriv af de filer, brugeren vælger.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }] }
  ]
}
